rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- GLOBAL HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isNotBanned() {
      return !exists(/databases/$(database)/documents/globalBans/$(request.auth.uid));
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/{document=**} {
      allow read: if isSignedIn();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isNotBanned();
      
      match /blockedUsers/{blockedId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /savedReports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isNotBanned() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }

    match /trophyCards/{cardId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isNotBanned() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }
    
    match /globalBans/{userId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via Admin Console/CLI
    }
  }
}
